<?xml version="1.0"?>
<package format="3">
  <name>isam2_depth</name>
  <version>0.2.0</version>
  <description>iSAM2 factor graph, GroundTruthMap, Informed RRT* global planner, PathTransformer, STVL VoxelCostmap, MPPI local controller (rollouts through a C++ port of dronehacks-sim quad.py), and Control Mode Multiplexer.</description>
  <maintainer email="noreply@example.com">dronehacks</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gtsam</depend>
  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>std_srvs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
